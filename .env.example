# ========================================================================
# UZDUB Play — muhit o'zgaruvchilari (.env.local ga nusxa oling)
# ========================================================================
# Bu faylni nusxalang:  cp .env.example .env.local
# .env.local hech qachon git'ga qo'shilmaydi (parollar maxfiy qoladi).

# --- Admin panel logini (MAJBURIY — o'zgartiring) -----------------------
ADMIN_EMAIL=admin@uzdub.com
ADMIN_PASSWORD=parol qo'ying

# --- next-auth sessiya kaliti (MAJBURIY) --------------------------------
# Generatsiya: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- AI to'ldirish (OpenRouter) va kino ma'lumotlari (TMDB) --------------
# OpenRouter: https://openrouter.ai -> Keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
# TMDB (real poster/ma'lumot): https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Sayt manzili (SEO uchun MUHIM) --------------------------------------
# Real domeningizni yozing (canonical, sitemap, OG uchun)
NEXT_PUBLIC_SITE_URL=https://uzdub.com

# --- UZDUB AI Office server-to-server draft API -------------------------
# Generatsiya: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
UZDUB_AI_OFFICE_API_KEY=

# --- Qidiruv tizimlarini tasdiqlash (deploydan keyin) -------------------
# Google Search Console -> "HTML tag" usulidagi content qiymati
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Yandex Webmaster -> meta tag content qiymati
NEXT_PUBLIC_YANDEX_VERIFICATION=

# --- Ma'lumotlar bazasi (Neon PostgreSQL) -------------------------------
# Neon connection string (console.neon.tech -> Connect -> Pooled connection)
DATABASE_URL="postgresql://user:parol@ep-...-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Rasm yuklash (Cloudflare R2) ---------------------------------------
# Cloudflare -> R2 -> Manage API Tokens -> Create (S3-mos kalit)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uzdub-play
R2_PUBLIC_URL=https://cdn.uzdub.com

# --- Telegram autentifikatsiyasi ----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Uzdubplay_bot
# Xavfsiz qiymat: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
